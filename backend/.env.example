# Copy to backend/.env and adjust.
PORT=5001
# Frontend URLs allowed to call the API (comma separated). Add the deployed frontend URL here.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5001,http://127.0.0.1:5001
# Login accounts for the demo: email:password:Display name, comma separated.
# Default when unset: demo@fieldshift.app / fieldshift2026
DEMO_USERS=demo@fieldshift.app:fieldshift2026:Demo Farmer
